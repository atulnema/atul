# Copy to .env.local and fill in. .env.local is git-ignored.

# Sarvam API key from https://dashboard.sarvam.ai/key-management
# Used server-side only by /api/sarvam/* (never sent to the browser).
SARVAM_API_KEY=

# Optional: override the Sarvam API host (staging, a mock server, etc.).
# SARVAM_API_BASE_URL=https://api.sarvam.ai
