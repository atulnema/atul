# Production domain. Used for canonical URLs, Open Graph, sitemap and schema.
NEXT_PUBLIC_SITE_URL=https://www.atulnemaseo.com

# Contact form endpoint. Any service that accepts a JSON POST works
# (Formspree, Getform, Basin, a Zapier/Make webhook or your own API route).
# Leave empty to keep the form in demo mode.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Newsletter endpoint (same format). Leave empty for demo mode.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
